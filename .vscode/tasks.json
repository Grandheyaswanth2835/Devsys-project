{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start MBIST Website",
      "type": "process",
      "command": "python",
      "args": ["-m", "backend.app"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Test MBIST Backend",
      "type": "process",
      "command": "python",
      "args": ["-m", "unittest", "discover", "-s", "backend", "-v"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
